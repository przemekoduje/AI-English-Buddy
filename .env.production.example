# Speakling Production Environment Variables Example
# Skopiuj ten plik jako szablon do konfiguracji zmiennych środowiskowych i Secret Managera w GCP.

# Ustawienia serwera
PORT=8080

# Klucze API AI
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
HF_API_TOKEN=your_huggingface_api_token_here

# Firebase Admin Service Account (Skondensowany string JSON konta serwisowego)
# Przykład wartości: {"type": "service_account", "project_id": "speakling-app", ...}
FIREBASE_CREDENTIALS_JSON=your_firebase_service_account_json_as_a_single_line_string

# Konfiguracja SMTP (Powiadomienia E-mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_gmail_username@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
