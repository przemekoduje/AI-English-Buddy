{
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/mobile",
        "destination": "/speakling/mobile/",
        "type": 302
      },
      {
        "source": "/mobile/:path*",
        "destination": "/speakling/mobile/:path*",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/speakling/mobile",
        "destination": "/speakling/mobile/index.html"
      },
      {
        "source": "/speakling/mobile/",
        "destination": "/speakling/mobile/index.html"
      },
      {
        "source": "/speakling/mobile/**",
        "destination": "/speakling/mobile/index.html"
      },
      {
        "source": "/speakling",
        "destination": "/speakling.html"
      },
      {
        "source": "/speakling/**",
        "destination": "/speakling.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
